AZAS_APP_NAME=Lunar Landing Site Navigator API
AZAS_ENVIRONMENT=local
# JSON array; add the actual frontend origin when deploying.
AZAS_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Local-only credentials. Production values are generated in Secrets Manager.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/azas?sslmode=disable
SPRING_DATASOURCE_USERNAME=azas_local
SPRING_DATASOURCE_PASSWORD=azas_local_only
