Project AZAS {
  database_type: 'PostgreSQL'
  Note: 'Each request starts a new analysis. The database keeps daily UTC summaries and the time windows used for mission planning. Intermediate hourly calculations, rankings and a live Horizons cache are outside its scope.'
}

Enum analysis_type {
  VISIBILITY
  DATE_OPPORTUNITIES
}

Enum execution_status {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

Enum result_status {
  COMPLETED
  PARTIAL
  TRUNCATED
  FAILED
}

Enum celestial_body {
  SUN
  EARTH
  JOINT
}

Enum opportunity_status {
  ENVIRONMENT_ONLY
  PRELIMINARY
  UNKNOWN
  EXCLUDED
}

Table terrain_dataset {
  terrain_dataset_id bigint [pk, increment]
  dataset_code varchar(100) [not null, note: 'Name of the source dataset, such as landing-screen.']
  dataset_version varchar(100) [not null]
  dataset_sha256 varchar(64) [not null, unique, note: 'Fingerprint of the source files and their metadata.']
  coordinate_reference_frame varchar(100) [not null]
  reference_sphere_radius_meters integer [not null, note: 'Radius of the reference Moon used to measure elevation, currently 1,737,400 metres.']
  distant_terrain_verified boolean [not null, note: 'Whether terrain beyond the surveyed area has been checked. The current dataset marks it as unverified.']
  source_metadata jsonb [not null, note: 'How the source defines heights and angles, fills gaps between samples and records the origin and fingerprint of each file.']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (dataset_code, dataset_version) [unique]
  }
  Note: 'One entry for each release of the lunar terrain data. Earlier releases remain available so past analyses can be traced to their source.'
}

Table landing_site {
  landing_site_id bigint [pk, increment]
  terrain_dataset_id bigint [not null]
  site_code varchar(50) [not null, note: 'Site code in the source catalogue.']
  latitude_degrees "double precision" [not null]
  longitude_degrees "double precision" [not null, note: 'Longitude in the source file, positive east and negative west.']
  surface_elevation_meters "double precision" [not null, note: 'Height of the surface above the lunar reference sphere.']
  observer_height_above_surface_meters "double precision" [not null, note: 'Height used to measure what is visible from the site. The reference dataset uses one metre.']
  low_slope_square_side_meters "double precision" [not null, note: 'Side length of a square area with slopes of at most five degrees.']
  terrain_screening_status varchar(30) [not null, note: 'Whether the site passed the terrain screening step. Landing safety needs a separate assessment.']
  indexes {
    (terrain_dataset_id, site_code) [unique]
  }
  Note: 'A candidate landing location on the Moon, with its coordinates, terrain and reference viewing height.'
}

Table horizon_sample {
  landing_site_id bigint [not null]
  azimuth_index smallint [not null, note: 'Direction sample numbered from 0 through 3,599.']
  azimuth_degrees "double precision" [not null, note: 'Direction clockwise from local north, sampled every tenth of a degree.']
  terrain_horizon_degrees "double precision" [not null, note: 'Angle of the terrain skyline. It can fall below the local horizontal.']
  blocking_terrain_horizontal_distance_meters "double precision" [not null]
  searched_surface_arc_distance_meters "double precision" [not null]
  indexes {
    (landing_site_id, azimuth_index) [pk]
  }
  Note: 'The height of the skyline in one direction at one landing site. One distance measures how far away the obstruction is on a flat local plane. The other follows the lunar surface to the last point surveyed.'
}

Table observer_sample {
  landing_site_id bigint [not null]
  observed_at timestamptz [not null, note: 'Time of the observation, sampled every ten minutes in UTC.']
  sun_azimuth_degrees "double precision" [not null]
  sun_elevation_degrees "double precision" [not null]
  earth_azimuth_degrees "double precision" [not null]
  earth_elevation_degrees "double precision" [not null]
  indexes {
    (landing_site_id, observed_at) [pk]
  }
  Note: 'Where the Sun and Earth appear in the sky at one landing site and time. The source archive records their directions and heights in degrees.'
}

Table launch_site {
  launch_site_id bigint [pk, note: 'Row number in the original launch site list, starting at one.']
  site_code varchar(50) [not null, unique]
  latitude_degrees "double precision" [not null]
  longitude_degrees_east "double precision" [not null, note: 'Longitude is positive east and negative west.']
  Note: 'A launch site on Earth. Its coordinates are used to find launch times for a chosen lunar touchdown.'
}

Table analysis_run {
  analysis_run_id uuid [pk]
  landing_site_id bigint [not null]
  analysis_type analysis_type [not null]
  execution_status execution_status [not null, default: 'PENDING']
  overall_result_status result_status [note: 'Outcome of the analysis as a whole. It stays empty while the analysis is running.']
  result_schema_version varchar(30)
  analysis_start_at timestamptz [not null]
  analysis_end_at timestamptz [not null]
  sample_interval_minutes integer [not null, note: 'Minutes between samples. The hourly visibility analysis uses 60.']
  mission_due_date date [note: 'Calendar date the user chose as the mission deadline when searching for landing windows.']
  mission_deadline_at timestamptz [note: 'Exact UTC cutoff used in the calculation.']
  analysis_parameters jsonb [not null, note: 'Copy of the choices used for this analysis, including surface activity duration, visibility requirements and orbit settings.']
  calculation_parameters_sha256 varchar(64) [not null, note: 'Fingerprint of the analysis settings. Two runs can use identical settings.']
  engine_version varchar(100) [not null]
  engine_sha256 varchar(64) [not null]
  failure_code varchar(100)
  diagnostic_messages text[]
  source_provenance jsonb [note: 'Records which Horizons responses the calculation used, when and where it retrieved them, their fingerprints and the assumptions behind the model.']
  created_at timestamptz [not null, default: `now()`]
  execution_started_at timestamptz
  execution_finished_at timestamptz
  execution_owner uuid [note: 'Identifies the worker responsible for an analysis submitted through the API.']
  execution_expires_at timestamptz [note: 'Time by which the job must finish, including time spent in the queue. A job still waiting or running at expiry can be marked as failed.']
  indexes {
    (landing_site_id, created_at)
  }
  checks {
    `analysis_end_at > analysis_start_at` [name: 'analysis_run_period_check']
    `sample_interval_minutes > 0` [name: 'analysis_run_interval_check']
    `analysis_type <> 'DATE_OPPORTUNITIES' OR (mission_due_date IS NOT NULL AND mission_deadline_at IS NOT NULL)` [name: 'analysis_run_deadline_check']
  }
  Note: 'One request to analyse a lunar site. Each run has its own identifier, settings and outcome, even when the same site and dates are analysed again.'
}

Table daily_analysis_result {
  daily_analysis_result_id bigint [pk, increment]
  analysis_run_id uuid [not null]
  analysis_date date [not null, note: 'UTC calendar date covered by this summary.']
  result_status result_status [not null]
  evaluated_period_start_at timestamptz [not null, note: 'First instant evaluated on this date.']
  evaluated_period_end_at timestamptz [not null, note: 'Last instant evaluated on this date.']
  sun_visible_time_ratio "double precision" [note: 'Fraction of the time with a known result during which the Sun was visible, from 0 to 1. Empty when unavailable.']
  earth_visible_time_ratio "double precision" [note: 'Fraction of the time with a known result during which Earth was visible, from 0 to 1. Empty when unavailable.']
  joint_visible_time_ratio "double precision" [note: 'Fraction of the time with a known joint result during which both bodies were visible, from 0 to 1. Empty when unavailable.']
  sun_known_time_ratio "double precision" [not null, note: 'Fraction of the evaluated period for which the model could determine whether the Sun was visible.']
  earth_known_time_ratio "double precision" [not null]
  joint_known_time_ratio "double precision" [not null]
  joint_unknown_time_ratio "double precision" [not null, note: 'Fraction of the evaluated period for which the model could not determine whether both bodies were visible together.']
  longest_sun_occultation_hours "double precision"
  longest_earth_occultation_hours "double precision" [note: 'Longest interval during which terrain hid the centre of Earth. Radio link quality requires a separate calculation.']
  terrain_coverage_status varchar(40) [not null]
  quality_flags text[]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (analysis_run_id, analysis_date) [unique]
  }
  checks {
    `evaluated_period_end_at > evaluated_period_start_at` [name: 'daily_result_period_check']
  }
  Note: 'One summary for each UTC day evaluated in a run. Each fraction is calculated from the samples for that day, over the part of the day the analysis covered.'
}

Table visibility_window {
  visibility_window_id bigint [pk, increment]
  daily_analysis_result_id bigint [not null]
  celestial_body celestial_body [not null]
  window_start_at timestamptz [not null]
  window_end_at timestamptz [not null]
  boundary_precision_seconds integer [not null, note: 'Precision of the start and end times given the spacing between samples.']
  indexes {
    (daily_analysis_result_id, celestial_body, window_start_at)
  }
  checks {
    `window_end_at > window_start_at` [name: 'visibility_window_period_check']
  }
  Note: 'A period during which the Sun, Earth or both were visible. A period crossing midnight UTC is split between the two daily summaries.'
}

Table landing_opportunity_result {
  landing_opportunity_result_id bigint [pk, increment]
  analysis_run_id uuid [not null]
  opportunity_code varchar(160) [not null, note: 'Identifies an entire touchdown window using the run identifier and window number.']
  opportunity_status opportunity_status [not null]
  surface_condition_status varchar(30) [not null, note: 'Whether the observations establish that the surface conditions are met or leave them uncertain.']
  terrain_coverage_status varchar(40) [not null]
  landing_window_start_at timestamptz [not null]
  landing_window_end_at timestamptz [not null]
  proposed_landing_at timestamptz [not null]
  surface_activity_finished_at timestamptz [not null]
  deadline_satisfied boolean [not null]
  launch_at timestamptz
  translunar_injection_at timestamptz [note: 'Time the spacecraft leaves its Earth parking orbit on its way to the Moon.']
  lunar_arrival_at timestamptz
  transfer_duration_hours "double precision"
  trajectory_solver_status varchar(60) [not null]
  arrival_position_error_kilometers "double precision"
  trajectory_verified boolean [not null, note: 'The current model produces preliminary trajectories. Flight verification is recorded as false.']
  calculation_model_level varchar(40) [not null]
  decision_reasons text[]
  provenance_id varchar(64) [not null]
  trajectory_calculation_details jsonb [note: 'Vectors and other details specific to the preliminary trajectory calculation.']
  indexes {
    (analysis_run_id, opportunity_code) [unique]
    (analysis_run_id, proposed_landing_at)
  }
  Note: 'The earliest and latest touchdown times for a landing window. Individual touchdown choices within a window have their own records.'
}

Ref: landing_site.terrain_dataset_id > terrain_dataset.terrain_dataset_id [delete: restrict]
Ref: horizon_sample.landing_site_id > landing_site.landing_site_id [delete: restrict]
Ref: observer_sample.landing_site_id > landing_site.landing_site_id [delete: restrict]
Ref: analysis_run.landing_site_id > landing_site.landing_site_id [delete: restrict]
Ref: daily_analysis_result.analysis_run_id > analysis_run.analysis_run_id [delete: restrict]
Ref: visibility_window.daily_analysis_result_id > daily_analysis_result.daily_analysis_result_id [delete: restrict]
Ref: landing_opportunity_result.analysis_run_id > analysis_run.analysis_run_id [delete: restrict]


Table surface_candidate_result {
  analysis_run_id uuid [not null]
  candidate_index integer [not null]
  candidate_code text [not null, unique]
  proposed_landing_at timestamptz [not null]
  surface_finished_at timestamptz [not null]
  window_start_at timestamptz [not null]
  window_end_at timestamptz [not null]
  status text [not null]
  surface_status text [not null]
  launch_at timestamptz
  tli_at timestamptz
  lunar_arrival_at timestamptz
  transfer_duration_hours "double precision"
  solver_status text [not null]
  position_residual_km "double precision"
  model text [not null]
  reasons jsonb [not null]
  solver_details jsonb
  indexes {
    (analysis_run_id, candidate_index) [pk]
  }
  Note: 'One specific touchdown time evaluated within a window, with the reasons for the outcome. Its number records evaluation order. The numerical solver stores its internal vectors as JSON.'
}

Table launch_option_batch {
  analysis_run_id uuid [pk]
  calculated_at timestamptz [not null]
  engine_sha256 char(64) [not null]
  model text [not null]
  assumptions jsonb [not null]
  touchdown_at timestamptz
  status text [not null]
  Note: 'Groups the launch options calculated for one touchdown. New analyses save this when they finish. For runs predating version 6 of the schema, the first lookup saves the calculation.'
}

Table launch_option_result {
  analysis_run_id uuid [not null]
  launch_site_id bigint [not null]
  site_code text [not null]
  latitude_degrees "double precision" [not null]
  longitude_degrees_east "double precision" [not null]
  status text [not null]
  candidate_code text
  launch_at timestamptz
  tli_at timestamptz
  lunar_arrival_at timestamptz
  proposed_landing_at timestamptz
  indexes {
    (analysis_run_id, launch_site_id) [pk]
    (analysis_run_id, candidate_code) [unique]
  }
  Note: 'Launch schedule for one Earth site, including sites with no suitable launch time. A copy of the site coordinates preserves the original result if the catalogue changes.'
}

Table trajectory_run {
  trajectory_run_id uuid [pk]
  analysis_run_id uuid [not null]
  launch_site_id bigint [not null]
  candidate_code text [not null]
  execution_status text [not null]
  created_at timestamptz [not null]
  started_at timestamptz
  finished_at timestamptz
  expires_at timestamptz [not null]
  engine_sha256 char(64) [not null]
  input_snapshot jsonb [not null]
  status text
  reason text
  solver_status text
  model text
  frame text
  origin text
  segment text
  arrival_target text
  nominal_sample_step_seconds integer
  position_residual_km "double precision"
  tli_delta_v_km_s "double precision"
  source_records jsonb [not null]
  Note: 'One attempt to calculate the flight path for a launch option. Each attempt has its own identifier and records the inputs, model version, data sources and outcome, including failures.'
}

Table trajectory_sample {
  trajectory_run_id uuid [not null]
  sample_index integer [not null]
  observed_at timestamptz [not null]
  elapsed_seconds bigint [not null]
  position_x_km "double precision" [not null]
  position_y_km "double precision" [not null]
  position_z_km "double precision" [not null]
  velocity_x_km_s "double precision" [not null]
  velocity_y_km_s "double precision" [not null]
  velocity_z_km_s "double precision" [not null]
  indexes {
    (trajectory_run_id, sample_index) [pk]
  }
  Note: 'Spacecraft position in kilometres and velocity in kilometres per second at successive times along a calculated path. The coordinates use an Earth-centred frame aligned with the International Celestial Reference Frame.'
}

Ref: surface_candidate_result.analysis_run_id > analysis_run.analysis_run_id
Ref: launch_option_batch.analysis_run_id - analysis_run.analysis_run_id
Ref: launch_option_result.analysis_run_id > launch_option_batch.analysis_run_id
Ref: trajectory_run.analysis_run_id > analysis_run.analysis_run_id
Ref: trajectory_run.(analysis_run_id, candidate_code) > launch_option_result.(analysis_run_id, candidate_code)
Ref: trajectory_sample.trajectory_run_id > trajectory_run.trajectory_run_id
